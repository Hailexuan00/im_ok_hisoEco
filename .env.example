# ============================================
# IMOK Backend Environment Variables
# ============================================

# Server
PORT=3000

# Firebase (REQUIRED)
# Base64 encoded Firebase service account JSON
FIREBASE_SERVICE_ACCOUNT_B64=your_base64_encoded_service_account_json

# Cron Settings (REQUIRED)
CRON_ENABLED=true
CRON_SECRET=your-random-long-secret-here

# Cron Query Limits (Optional - has defaults)
BATCH_LIMIT=100
MAX_PER_RUN=200

# Email Provider (REQUIRED)
# Options: resend, sendgrid, nodemailer
EMAIL_PROVIDER=resend

# For Resend / SendGrid
EMAIL_API_KEY=your_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# For Nodemailer (Gmail SMTP)
# GMAIL_USER=your@gmail.com
# GMAIL_APP_PASSWORD=your_app_password
